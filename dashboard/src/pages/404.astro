---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="flex flex-col items-center justify-center py-24 text-center space-y-6">
    <span class="text-6xl">🔍</span>
    <h1 class="text-4xl font-bold tracking-tight text-gray-900">Page not found</h1>
    <p class="text-gray-500 max-w-md">
      This digest doesn't exist yet, or the link you followed might be broken.
    </p>
    <a
      href="/ai-digests/"
      class="inline-flex items-center gap-2 rounded-lg bg-digest-frontend px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:brightness-110 transition-all no-underline"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5m7-7l-7 7 7 7" />
      </svg>
      Back to all digests
    </a>
  </div>
</BaseLayout>
