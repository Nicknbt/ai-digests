---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.tsx';
import { getAllArchives } from '../lib/archives.js';

const archives = getAllArchives();

const counts = {
  all: archives.length,
  frontend: archives.filter((a) => a.frontmatter.type === 'frontend').length,
  'rabbit-hole': archives.filter((a) => a.frontmatter.type === 'rabbit-hole').length,
};

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
}

function excerpt(body: string, max = 160) {
  const text = body
    .replace(/^#+\s+.*$/gm, '')     // strip headings
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // strip markdown links
    .replace(/[*_~`#|>-]/g, '')     // strip other markdown
    .replace(/\s+/g, ' ')           // collapse whitespace
    .trim();
  if (text.length <= max) return text;
  return text.slice(0, max).trimEnd() + '…';
}
---

<BaseLayout title="Home">
  <div class="space-y-8">
    <!-- Hero -->
    <div class="space-y-2">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Digest Archive</h2>
      <p class="text-gray-500">
        A collection of weekly AI-generated digests covering the frontend ecosystem and interesting internet discoveries.
      </p>
    </div>

    <!-- Filter -->
    <div class="not-content" client:load>
      <FilterBar
        counts={counts}
        onChange={() => {}} /* handled via DOM in DigestGrid */
        client:load
      />
    </div>

    <!-- Digest Grid -->
    <div id="digest-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {archives.map((a) => (
        <a
          href={`/ai-digests/archives/${a.slug}`}
          class="group relative flex flex-col rounded-xl border border-gray-200 bg-white p-5 no-underline shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5"
        >
          <!-- Type badge -->
          <div class="mb-3 flex items-center gap-2">
            <span class={[
              'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium',
              a.frontmatter.type === 'frontend'
                ? 'bg-blue-50 text-blue-700'
                : 'bg-purple-50 text-purple-700',
            ].join(' ')}>
              <span>{a.frontmatter.icon || '📄'}</span>
              <span>{a.frontmatter.type === 'frontend' ? 'Frontend' : 'Rabbit Hole'}</span>
            </span>
          </div>

          <!-- Title -->
          <h3 class="mb-1 text-base font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
            {a.frontmatter.title || 'Untitled Digest'}
          </h3>

          <!-- Date -->
          <p class="mb-2 text-sm text-gray-500">
            {formatDate(a.frontmatter.date)}
          </p>

          <!-- Excerpt -->
          <p class="mt-auto text-sm leading-relaxed text-gray-600 line-clamp-3">
            {excerpt(a.body)}
          </p>

          <!-- Arrow indicator -->
          <span class="mt-3 text-sm font-medium text-blue-600 opacity-0 transition-opacity group-hover:opacity-100">
            Read more →
          </span>
        </a>
      ))}
    </div>

    {archives.length === 0 && (
      <div class="rounded-xl border-2 border-dashed border-gray-200 p-12 text-center">
        <p class="text-lg text-gray-400">No digests yet — archives will appear here after the first run.</p>
      </div>
    )}
  </div>
</BaseLayout>
